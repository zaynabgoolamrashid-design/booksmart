<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="BookSmart.Site1" %>


<!DOCTYPE html>
<html>
<head runat="server">
    <title>BookSmart</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <link href="Content/Site1.css" rel="stylesheet" />
</head>
<body class="body-background">
    <form id="form1" runat="server">
        <div class="d-flex flex-column min-vh-100">
            <!-- NAVBAR -->
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark-brown">
                <div class="container-fluid">
                    <a class="navbar-brand d-flex align-items-center" href="<%= ResolveUrl("~/Default.aspx") %>">
                        <img src="~/Images/logo.png" runat="server" alt="Logo" width="32" height="32" class="me-2 rounded-circle" />
                        <span>BookSmart</span>
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarContent">
                        <!-- Left side nav links -->
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <!-- Categories Dropdown -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="catDropdown" role="button" data-bs-toggle="dropdown">
                                    Categories
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="Category.aspx?genre=Romance">Romance</a></li>
                                    <li><a class="dropdown-item" href="Category.aspx?genre=Mystery%20%26%20Thriller">Mystery & Thriller</a></li>
                                    <li><a class="dropdown-item" href="Category.aspx?genre=Science%20Fiction">Sci-Fi</a></li>
                                    <li><a class="dropdown-item" href="Category.aspx?genre=Horror">Horror</a></li>
                                    <li><a class="dropdown-item" href="Category.aspx?genre=Adventure">Adventure</a></li>
                                    <li><a class="dropdown-item" href="Category.aspx?genre=Business%20%26%20Economics">Business & Economics</a></li>
                                    <li><a class="dropdown-item" href="Category.aspx?genre=Poetry">Poetry</a></li>
                                </ul>
                            </li>
                            <li class="nav-item"><a class="nav-link" href="About.aspx">About</a></li>
                            <li class="nav-item"><a class="nav-link" href="Contact.aspx">Contact</a></li>
                        </ul>

                        <!-- Search & Right side actions -->
                        <div class="d-flex align-items-center">
                            <asp:TextBox ID="txtSearch" runat="server" CssClass="form-control me-2" Placeholder="Search books..."></asp:TextBox>
                            <asp:Button ID="btnSearch" runat="server" Text="Search" CssClass="btn btn-outline-light me-3" OnClick="btnSearch_Click" />

                            <ul class="navbar-nav ms-auto">
                              <asp:PlaceHolder ID="phNotLoggedIn" runat="server">
                                   <li class="nav-item">
                              <a class="nav-link" href="Register.aspx">Register</a>
                              </li>
                         <li class="nav-item">
                         <a class="nav-link" href="Login.aspx">Login</a>
                        </li>
                      </asp:PlaceHolder>

                 <asp:PlaceHolder ID="phLoggedIn" runat="server">
                 <li class="nav-item">
                 <span class="nav-link">Hi, <asp:Label ID="lblUsername" runat="server"></asp:Label></span>
                  </li>
                 <li class="nav-item">
              <a class="nav-link"  href="<%= ResolveUrl("~/Logout.aspx") %>">Logout</a> <!-- ✅ ALWAYS correct -->

                  </li>
              </asp:PlaceHolder>

        <asp:PlaceHolder ID="phCustomerLinks" runat="server" Visible="false">
         <li class="nav-item">
        <a class="nav-link" href="OrderHistory.aspx">📦 My Orders</a>
         </li>
</asp:PlaceHolder>
                                <!-- Admin Links -->
<asp:PlaceHolder ID="phAdminLinks" runat="server" Visible="false">
    <li class="nav-item">
       <a class="nav-link" href="<%= ResolveUrl("~/Admin/AdminHome.aspx") %>">⚙ Admin Dashboard</a>

    </li>
</asp:PlaceHolder>
              </ul>


                            <a class="btn btn-warning ms-2" href="Cart.aspx">🛒 Cart</a>
                        </div>
                    </div>
                </div>
            </nav>

            <main class="flex-fill">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>

            <!-- Footer -->
            <footer class="bg-dark text-light text-center py-3">
                <div class="container">
                    <p class="mb-1">&copy; <%= DateTime.Now.Year %> BookSmart. All rights reserved.</p>
                </div>
            </footer>
        </div>
    </form>
</body>
</html>