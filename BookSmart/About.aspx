<%@ Page Title="" Language="C#" MasterPageFile="~/Site1.Master" AutoEventWireup="true" CodeBehind="About.aspx.cs" Inherits="BookSmart.About" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">

    <div class="container py-5" style="max-width: 800px;">
        <h2 class="mb-4">About BookSmart</h2>

        <h4>📖 Our History</h4>
        <p>
            BookSmart was founded in 2024 with a single goal: to make quality books more accessible to students and readers across Mauritius. 
            What started as a small project among a group of software and literature enthusiasts quickly evolved into a growing online platform.
        </p>
        <p>
            We noticed that many students and professionals lacked affordable, reliable access to both academic and recreational reading. 
            That’s when BookSmart came to life — to fill the gap.
        </p>

        <h4 class="mt-4">🌟 Our Story</h4>
        <p>
            We believe reading should be easy, inspiring, and available to everyone. Our collection covers genres like Romance, Thriller, 
            Science Fiction, Horror, Adventure, Business & Economics, and Poetry — each carefully curated with you in mind.
        </p>
        <p>
            Whether you're a student preparing for exams, a poetry lover browsing for inspiration, or someone simply craving a good story,
            BookSmart is your digital reading corner.
        </p>

        <h4 class="mt-4">🚀 Our Mission</h4>
        <p>
            To make reading more accessible, enjoyable, and affordable for all.
        </p>
    </div>

</asp:Content>

